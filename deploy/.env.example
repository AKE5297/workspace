# docker-compose 环境变量示例
# 复制为 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# docker compose -f deploy/docker-compose.yml up -d --build

# 宿主机暴露端口（nginx 方案默认 80，node 方案默认 3001）
HTTP_PORT=80

# 必填：JWT 签名密钥，请改为足够随机的长字符串
JWT_SECRET=change-me-in-production

# 公开访问地址，用于生成分享链接与 RSS
PUBLIC_BASE_URL=http://localhost

# RAG 问答所需的大模型配置（不配置则问答接口返回 needsKey）
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Telegram 推送（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件通知（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
