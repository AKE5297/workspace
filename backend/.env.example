# 服务端口
PORT=3001

# JWT 配置
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=7d

# 数据目录（JSON 文件存储）
DATA_DIR=/workspace/backend/data

# 回收站保留天数
RECYCLE_DAYS=30

# LLM 配置（AI 摘要 / 智能标签 / 知识库智能问答 RAG）— 请填入你自己的密钥
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
AI_SUMMARY_ENABLED=true
AI_TAG_ENABLED=true

# Telegram 推送
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP 邮件推送
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 对外公开地址（用于分享链接生成）
PUBLIC_BASE_URL=
